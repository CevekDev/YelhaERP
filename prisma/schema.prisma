// YelhaSubs — Schéma Prisma minimal
// Multi-tenant : chaque table filtre par companyId

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENTREPRISES (tenant root)
// ============================================================
model Company {
  id           String       @id @default(cuid())
  name         String
  businessType BusinessType @default(NONE)
  phone        String?
  email        String?
  plan         Plan         @default(TRIAL)
  trialEndsAt  DateTime?
  isBanned     Boolean      @default(false)
  bannedAt     DateTime?
  isPartner    Boolean      @default(false)
  partnerSince DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  users                User[]
  clients              Client[]
  notifications        Notification[]
  subApiKeys           SubApiKey[]
  webhooks             Webhook[]
  subscriptionPlans    SubscriptionPlan[]
  subscriptions        Subscription[]
  subscriptionSettings SubscriptionSettings?
  yelhaSubscription    YelhaSubscription?
}

enum BusinessType {
  RC
  AE
  NONE
}

enum Plan {
  TRIAL
  STARTER
  PRO
  AGENCY
  BUSINESS
  ENTERPRISE
}

enum YelhaSubStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  PAUSED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

// ============================================================
// AUTH (NextAuth)
// ============================================================
model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  password           String?
  name               String
  phone              String?
  birthDate          DateTime?
  emailVerified      DateTime?
  verificationToken  String?   @unique
  verificationExpiry DateTime?
  role               Role      @default(OWNER)
  isSuperAdmin       Boolean   @default(false)
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  @@index([companyId])
}

enum Role {
  OWNER
  ADMIN
  EMPLOYEE
  READONLY
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// CLIENTS (les clients de l'utilisateur — référencés par Subscription)
// ============================================================
model Client {
  id          String     @id @default(cuid())
  companyId   String
  clientType  ClientType @default(INDIVIDUAL)
  name        String
  firstName   String?
  nif         String?
  nis         String?
  rc          String?
  address     String?
  wilaya      String?
  phone       String?
  email       String?
  description String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([companyId])
  @@index([companyId, name])
}

enum ClientType {
  COMPANY
  INDIVIDUAL
}

// ============================================================
// NOTIFICATIONS
// ============================================================
model Notification {
  id        String           @id @default(cuid())
  companyId String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  priority  String           @default("NORMAL")
  actionUrl String?
  createdAt DateTime         @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, isRead])
  @@index([companyId, createdAt])
}

enum NotificationType {
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
  ANOMALY
}

// ============================================================
// CLÉS API (sub-api — accès externe pour intégrer YelhaSubs)
// ============================================================
model SubApiKey {
  id         String    @id @default(cuid())
  companyId  String
  name       String?
  keyHash    String    @unique
  keyPrefix  String
  lastUsedAt DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ============================================================
// WEBHOOKS sortants (notifier des events vers un endpoint client)
// ============================================================
model Webhook {
  id              String    @id @default(cuid())
  companyId       String
  url             String
  events          String[]
  secret          String
  isActive        Boolean   @default(true)
  description     String?
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, isActive])
}

// ============================================================
// ABONNEMENTS CLIENTS (le cœur de YelhaSubs)
// ============================================================
model SubscriptionPlan {
  id            String      @id @default(cuid())
  companyId     String
  name          String
  description   String?     @db.Text
  price         Decimal     @db.Decimal(10, 2)
  currency      String      @default("DZD")
  interval      SubInterval @default(MONTHLY)
  intervalCount Int         @default(1)
  trialDays     Int?
  features      String[]    @default([])
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([companyId])
}

model Subscription {
  id          String    @id @default(cuid())
  companyId   String
  clientId    String
  planId      String
  status      SubStatus @default(ACTIVE)
  startDate   DateTime  @default(now())
  endDate     DateTime?
  nextBilling DateTime?
  cancelledAt DateTime?
  notes       String?   @db.Text
  // Email du client (pour rappels)
  clientEmail String?
  // Anti-spam : derniers emails envoyés (date)
  lastRenewalReminder3At DateTime?
  lastRenewalReminderAt  DateTime?
  lastTrialEndReminderAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client           @relation(fields: [clientId], references: [id])
  plan    SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([companyId])
  @@index([companyId, status])
  @@index([clientId])
}

model SubscriptionSettings {
  id             String   @id @default(cuid())
  companyId      String   @unique
  // Paiement (affichés dans les emails de rappel)
  whatsapp       String?
  ccpNumber      String?
  chargilyKey    String?
  // Email
  emailLanguage  String   @default("fr") // fr | en | ar
  emailTemplates Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

enum SubInterval {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum SubStatus {
  PENDING
  TRIAL
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

// ============================================================
// FACTURATION SAAS YelhaSubs (abonnement YelhaSubs lui-même)
// ============================================================
model YelhaSubscription {
  id                 String         @id @default(cuid())
  companyId          String         @unique
  planId             String         @default("trial")
  status             YelhaSubStatus @default(TRIAL)
  billingCycle       BillingCycle   @default(MONTHLY)

  trialEndsAt        DateTime?
  currentPeriodStart DateTime       @default(now())
  currentPeriodEnd   DateTime
  cancelledAt        DateTime?
  pausedAt           DateTime?

  monthlyAmount      Int            @default(0)
  lastPaymentAt      DateTime?
  lastPaymentRef     String?
  chargilySubId      String?

  limitEmails        Int            @default(50)
  limitApiReq        Int            @default(500)
  usageEmails        Int            @default(0)
  usageApiReq        Int            @default(0)
  usageResetAt       DateTime       @default(now())

  lastRenewalReminder3At DateTime?
  lastRenewalReminder1At DateTime?

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payments YelhaPayment[]
}

model YelhaPayment {
  id             String       @id @default(cuid())
  subscriptionId String
  amount         Int
  planId         String
  billingCycle   BillingCycle
  method         String
  status         String       @default("PENDING")
  chargilyId     String?
  chargilyLink   String?
  ccpRef         String?
  periodStart    DateTime
  periodEnd      DateTime
  paidAt         DateTime?
  createdAt      DateTime     @default(now())

  subscription YelhaSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

// ============================================================
// CONFIG SYSTÈME (tarification admin)
// ============================================================
model SystemConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
