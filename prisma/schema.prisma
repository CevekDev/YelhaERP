// YelhaERP — Schéma Prisma complet
// Multi-tenant : chaque table filtre par companyId

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENTREPRISES (tenant root)
// ============================================================
model Company {
  id           String       @id @default(cuid())
  name         String
  businessType BusinessType @default(NONE)
  legalForm    String?
  nif          String?
  nis          String?
  rc           String?
  aeCardNumber String?
  address      String?
  wilaya       String?
  phone        String?
  email        String?
  bankRib      String?
  plan          Plan         @default(TRIAL)
  activeModules String[]     @default(["dashboard","ventes","achats","stocks"])
  aiQuotaUsed   Int          @default(0)
  aiQuotaReset DateTime     @default(now())
  trialEndsAt  DateTime?
  isBanned     Boolean      @default(false)
  bannedAt     DateTime?
  isPartner    Boolean      @default(false)
  partnerSince DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  users              User[]
  clients            Client[]
  suppliers          Supplier[]
  invoices           Invoice[]
  products           Product[]
  stockMovements     StockMovement[]
  journalEntries     JournalEntry[]
  payrollEntries     PayrollEntry[]
  employees          Employee[]
  taxDeclarations    TaxDeclaration[]
  aiConversations    AiConversation[]
  subApiKeys         SubApiKey[]
  purchaseOrders     PurchaseOrder[]
  quotes             Quote[]
  notifications      Notification[]
  expenses           Expense[]
  clientMessages     ClientMessage[]
  // New modules
  accountsPCN        AccountPCN[]
  accountEntries     AccountEntry[]
  fiscalPeriods      FiscalPeriod[]
  goodsReceipts      GoodsReceipt[]
  supplierInvoices   SupplierInvoice[]
  poApprovals        POApproval[]
  leads              Lead[]
  pipelines          Pipeline[]
  boms               BOM[]
  productionOrders   ProductionOrder[]
  projects           Project[]
  timeLogs           TimeLog[]
  leaveTypes         LeaveType[]
  leaveRequests      LeaveRequest[]
  jobPostings        JobPosting[]
  applications       Application[]
  performanceReviews PerformanceReview[]
  warehouses         Warehouse[]
  stockPositions     StockPosition[]
  stockTransfers     StockTransfer[]
  exchangeRates      ExchangeRate[]
  apiKeys            ApiKey[]
  webhooks           Webhook[]
  // POS
  posRegisters       PosRegister[]
  posSessions        PosSession[]
  posSales           PosSale[]
  posDebts           PosDebt[]
  // E-commerce
  deliveryCompanies  DeliveryCompany[]
  deliveryDrivers    DeliveryDriver[]
  ecomOrders         EcomOrder[]
  // Abonnements
  subscriptionPlans     SubscriptionPlan[]
  subscriptions         Subscription[]
  subscriptionSettings  SubscriptionSettings?
  // Restaurant
  restaurantConfig   RestaurantConfig?
  restaurantRooms    RestaurantRoom[]
  restaurantTables   RestaurantTable[]
  reservations       Reservation[]
  menuCategories     MenuCategory[]
  menuItems          MenuItem[]
  ingredients        Ingredient[]
  ingredientMovements IngredientMovement[]
  restaurantOrders   RestaurantOrder[]
  kdsTickets         KdsTicket[]
  loyaltyClients           LoyaltyClient[]
  restaurantOrderSequences RestaurantOrderSequence[]
  invoiceSequences         InvoiceSequence[]
  yelhaSubscription        YelhaSubscription?
  appSubscriptions         AppSubscription[]
}

enum BusinessType {
  RC
  AE
  NONE
}

enum Plan {
  TRIAL
  STARTER
  PRO
  AGENCY
  BUSINESS
  ENTERPRISE
}

enum YelhaSubStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  PAUSED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

// ============================================================
// UTILISATEURS
// ============================================================
model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  password           String?
  name               String
  phone              String?
  birthDate          DateTime?
  emailVerified      DateTime?
  verificationToken  String?   @unique
  verificationExpiry DateTime?
  role               Role      @default(EMPLOYEE)
  isSuperAdmin       Boolean   @default(false)
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  expenses Expense[]

  @@index([companyId])
}

enum Role {
  OWNER
  ADMIN
  ACCOUNTANT
  EMPLOYEE
  READONLY
}

// NextAuth adapters
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// CLIENTS
// ============================================================
model Client {
  id          String     @id @default(cuid())
  companyId   String
  clientType  ClientType @default(COMPANY)
  name        String
  firstName   String?
  nif         String?
  nis         String?
  rc          String?
  address     String?
  wilaya      String?
  phone       String?
  email       String?
  description String?    @db.Text
  portalToken String?    @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  quotes   Quote[]
  messages ClientMessage[]
  leads    Lead[]
  projects Project[]
  posSales      PosSale[]
  posDebts      PosDebt[]
  subscriptions Subscription[]

  @@index([companyId])
  @@index([companyId, name])
}

enum ClientType {
  COMPANY
  INDIVIDUAL
}

// ============================================================
// FOURNISSEURS
// ============================================================
model Supplier {
  id        String   @id @default(cuid())
  companyId String
  name      String
  nif       String?
  nis       String?
  rc        String?
  address   String?
  wilaya    String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrders   PurchaseOrder[]
  supplierInvoices SupplierInvoice[]

  @@index([companyId])
  @@index([companyId, name])
}

// ============================================================
// FACTURES
// ============================================================
model Invoice {
  id             String        @id @default(cuid())
  companyId      String
  clientId       String
  number         String
  type           InvoiceType
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime
  dueDate        DateTime?
  subtotal       Decimal       @db.Decimal(15, 2)
  taxAmount      Decimal       @db.Decimal(15, 2)
  total          Decimal       @db.Decimal(15, 2)
  currency       String        @default("DZD")
  exchangeRate   Decimal?      @db.Decimal(12, 6)
  amountDZD      Decimal?      @db.Decimal(15, 2)
  notes          String?
  isShopifyOrder Boolean       @default(false)
  isWooOrder     Boolean       @default(false)
  externalId     String?
  portalToken    String?       @unique
  quoteId        String?       @unique
  projectId      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client   Client           @relation(fields: [clientId], references: [id])
  lines    InvoiceLine[]
  payments InvoicePayment[]
  quote    Quote?           @relation(fields: [quoteId], references: [id])
  project  Project?         @relation(fields: [projectId], references: [id])
  posSale  PosSale?
  posDebt  PosDebt?

  @@unique([companyId, number])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, issueDate])
  @@index([companyId, clientId])
}

model InvoicePayment {
  id         String        @id @default(cuid())
  invoiceId  String
  amount     Decimal       @db.Decimal(15, 2)
  method     PaymentMethod
  reference  String?
  proofUrl   String?
  paidAt     DateTime      @default(now())
  notes      String?
  createdAt  DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

enum PaymentMethod {
  CCP_VIREMENT
  CHARGILY_EDAHABIA
  CHARGILY_CIB
  CASH
  BANK_TRANSFER
}

enum InvoiceType {
  STANDARD
  SIMPLIFIED
  PROFORMA
  CREDIT_NOTE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIAL
  OVERDUE
  CANCELLED
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Decimal @db.Decimal(10, 3)
  unitPrice   Decimal @db.Decimal(15, 2)
  taxRate     Decimal @db.Decimal(5, 2) @default(19)
  total       Decimal @db.Decimal(15, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ============================================================
// DEVIS
// ============================================================
model Quote {
  id            String      @id @default(cuid())
  companyId     String
  clientId      String
  number        String
  status        QuoteStatus @default(DRAFT)
  issueDate     DateTime
  expiryDate    DateTime?
  subtotal      Decimal     @db.Decimal(15, 2)
  taxAmount     Decimal     @db.Decimal(15, 2)
  total         Decimal     @db.Decimal(15, 2)
  currency      String      @default("DZD")
  exchangeRate  Decimal?    @db.Decimal(12, 6)
  amountDZD     Decimal?    @db.Decimal(15, 2)
  notes         String?
  portalToken   String?     @unique
  followUpAt    DateTime?
  followUpCount Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client      @relation(fields: [clientId], references: [id])
  lines   QuoteLine[]
  invoice Invoice?

  @@unique([companyId, number])
  @@index([companyId])
  @@index([companyId, status])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

model QuoteLine {
  id          String  @id @default(cuid())
  quoteId     String
  productId   String?
  description String
  quantity    Decimal @db.Decimal(10, 3)
  unitPrice   Decimal @db.Decimal(15, 2)
  taxRate     Decimal @db.Decimal(5, 2) @default(19)
  total       Decimal @db.Decimal(15, 2)

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([quoteId])
}

// ============================================================
// PRODUITS & STOCK
// ============================================================
model Product {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  sku         String?
  barcode     String?
  description String?
  unitPrice   Decimal  @db.Decimal(15, 2)
  taxRate     Decimal  @db.Decimal(5, 2) @default(19)
  stockQty    Decimal  @db.Decimal(10, 3) @default(0)
  stockAlert  Decimal  @db.Decimal(10, 3) @default(0)
  unit        String?
  weight      Decimal? @db.Decimal(10, 3)
  dimensions  String?
  format      String?
  isFragile   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company                Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  variants               ProductVariant[]
  stockMovements         StockMovement[]
  quoteLines             QuoteLine[]
  boms                   BOM[]
  bomComponents          BOMComponent[]
  productionConsumptions ProductionConsumption[]
  stockPositions         StockPosition[]
  transferLines          StockTransferLine[]

  @@index([companyId])
  @@index([companyId, sku])
  @@index([companyId, barcode])
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  name         String
  sku          String?
  barcode      String?
  size         String?
  color        String?
  stockQty     Decimal  @db.Decimal(10, 3) @default(0)
  priceOverride Decimal? @db.Decimal(15, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([barcode])
}

model StockMovement {
  id          String       @id @default(cuid())
  companyId   String
  productId   String
  warehouseId String?
  type        MovementType
  quantity    Decimal      @db.Decimal(10, 3)
  unitCost    Decimal?     @db.Decimal(15, 2)
  reference   String?
  note        String?
  createdAt   DateTime     @default(now())

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([companyId])
  @@index([productId])
  @@index([companyId, createdAt])
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

// ============================================================
// EMPLOYÉS & PAIE
// ============================================================
model Employee {
  id           String   @id @default(cuid())
  companyId    String
  firstName    String
  lastName     String
  nin          String?
  socialNumber String?
  position     String?
  department   String?
  managerId    String?
  baseSalary   Decimal  @db.Decimal(15, 2)
  hireDate     DateTime
  isActive     Boolean  @default(true)

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager            Employee?           @relation("ManagerReports", fields: [managerId], references: [id])
  reports            Employee[]          @relation("ManagerReports")
  payrollEntries     PayrollEntry[]
  leaveRequests      LeaveRequest[]
  performanceReviews PerformanceReview[]

  @@index([companyId])
}

model PayrollEntry {
  id           String  @id @default(cuid())
  companyId    String
  employeeId   String
  month        Int
  year         Int
  baseSalary   Decimal @db.Decimal(15, 2)
  grossSalary  Decimal @db.Decimal(15, 2)
  cnasEmployee Decimal @db.Decimal(15, 2)
  cnasEmployer Decimal @db.Decimal(15, 2)
  irg          Decimal @db.Decimal(15, 2)
  netSalary    Decimal @db.Decimal(15, 2)
  isPaid       Boolean @default(false)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([companyId, employeeId, month, year])
  @@index([companyId])
  @@index([companyId, year, month])
}

// ============================================================
// COMPTABILITÉ (legacy — simple journal, utilisé par dépenses)
// ============================================================
model JournalEntry {
  id          String   @id @default(cuid())
  companyId   String
  date        DateTime
  reference   String
  description String
  debit       Decimal  @db.Decimal(15, 2)
  credit      Decimal  @db.Decimal(15, 2)
  accountCode String
  accountName String
  createdAt   DateTime @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@index([companyId])
  @@index([companyId, date])
  @@index([companyId, accountCode])
}

// ============================================================
// COMPTABILITÉ PCN (Plan Comptable National algérien)
// ============================================================
model AccountPCN {
  id         String      @id @default(cuid())
  companyId  String
  code       String
  name       String
  class      Int
  type       AccountType
  isActive   Boolean     @default(true)
  parentCode String?

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountLines AccountLine[]

  @@unique([companyId, code])
  @@index([companyId, class])
}

enum AccountType {
  ACTIF
  PASSIF
  CHARGE
  PRODUIT
}

model AccountEntry {
  id          String   @id @default(cuid())
  companyId   String
  date        DateTime
  reference   String
  description String
  period      String
  isClosed    Boolean  @default(false)
  createdAt   DateTime @default(now())

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   AccountLine[]

  @@index([companyId, period])
  @@index([companyId, date])
}

model AccountLine {
  id          String  @id @default(cuid())
  entryId     String
  accountCode String
  accountId   String
  description String
  debit       Decimal @db.Decimal(15, 2) @default(0)
  credit      Decimal @db.Decimal(15, 2) @default(0)

  entry   AccountEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account AccountPCN   @relation(fields: [accountId], references: [id])

  @@index([entryId])
  @@index([accountId])
}

model FiscalPeriod {
  id        String    @id @default(cuid())
  companyId String
  year      Int
  month     Int
  isClosed  Boolean   @default(false)
  closedAt  DateTime?
  closedBy  String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, year, month])
  @@index([companyId])
}

// ============================================================
// FISCALITÉ
// ============================================================
model TaxDeclaration {
  id        String    @id @default(cuid())
  companyId String
  type      String
  period    String
  amount    Decimal   @db.Decimal(15, 2)
  status    String    @default("PENDING")
  dueDate   DateTime
  paidAt    DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, status])
}

// ============================================================
// DÉPENSES & NOTES DE FRAIS
// ============================================================
model Expense {
  id             String          @id @default(cuid())
  companyId      String
  userId         String
  category       ExpenseCategory
  amount         Decimal         @db.Decimal(15, 2)
  currency       String          @default("DZD")
  exchangeRate   Decimal?        @db.Decimal(12, 6)
  amountDZD      Decimal?        @db.Decimal(15, 2)
  description    String
  date           DateTime
  status         ExpenseStatus   @default(PENDING)
  receiptUrl     String?
  receiptText    String?
  journalEntryId String?
  taxAmount      Decimal?        @db.Decimal(15, 2)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, date])
}

enum ExpenseCategory {
  TRANSPORT
  REPAS
  HEBERGEMENT
  FOURNITURES
  COMMUNICATION
  MAINTENANCE
  PUBLICITE
  FORMATION
  HONORAIRES
  AUTRE
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  EXPORTED
}

// ============================================================
// NOTIFICATIONS
// ============================================================
model Notification {
  id        String           @id @default(cuid())
  companyId String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  priority  String           @default("NORMAL")
  actionUrl String?
  createdAt DateTime         @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, isRead])
  @@index([companyId, createdAt])
}

enum NotificationType {
  FISCAL_DEADLINE
  ANOMALY
  STOCK_ALERT
  INVOICE_OVERDUE
  CASHFLOW_WARNING
  AI_INSIGHT
  QUOTE_EXPIRING
  LEAVE_REQUEST_PENDING
  LEAD_STAGE_CHANGED
  PO_APPROVAL_NEEDED
  PRODUCTION_ORDER_DELAYED
  PROJECT_BUDGET_EXCEEDED
  RESERVATION_REMINDER
  ORDER_DELAYED
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
}

// ============================================================
// MESSAGERIE PORTAIL CLIENT
// ============================================================
model ClientMessage {
  id         String   @id @default(cuid())
  companyId  String
  clientId   String
  token      String
  content    String   @db.Text
  fromClient Boolean  @default(true)
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id])

  @@index([companyId, clientId])
  @@index([token])
}

// ============================================================
// IA
// ============================================================
model AiConversation {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  title     String   @default("Nouvelle conversation")
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, userId])
}

// ============================================================
// CLÉS API ABONNEMENTS (sub-api)
// ============================================================
model SubApiKey {
  id         String    @id @default(cuid())
  companyId  String
  name       String?
  keyHash    String    @unique
  keyPrefix  String
  lastUsedAt DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([keyPrefix])
}

// ============================================================
// BONS DE COMMANDE & ACHATS
// ============================================================
model PurchaseOrder {
  id         String    @id @default(cuid())
  companyId  String
  supplierId String
  number     String
  status     POStatus  @default(DRAFT)
  subtotal   Decimal   @db.Decimal(15, 2) @default(0)
  taxAmount  Decimal   @db.Decimal(15, 2) @default(0)
  total      Decimal   @db.Decimal(15, 2)
  orderDate  DateTime
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier         Supplier             @relation(fields: [supplierId], references: [id])
  lines            PurchaseOrderLine[]
  goodsReceipts    GoodsReceipt[]
  supplierInvoices SupplierInvoice[]
  approvals        POApproval[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([companyId, supplierId])
  @@index([companyId, status])
}

enum POStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  INVOICED
  CANCELLED
}

model PurchaseOrderLine {
  id              String  @id @default(cuid())
  purchaseOrderId String
  productId       String?
  description     String
  quantity        Decimal @db.Decimal(10, 3)
  unitPrice       Decimal @db.Decimal(15, 2)
  taxRate         Decimal @db.Decimal(5, 2) @default(19)
  total           Decimal @db.Decimal(15, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}

model GoodsReceipt {
  id              String   @id @default(cuid())
  companyId       String
  purchaseOrderId String
  number          String
  receivedDate    DateTime
  warehouseId     String?
  status          String   @default("PENDING")
  notes           String?
  createdAt       DateTime @default(now())

  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  warehouse     Warehouse?         @relation(fields: [warehouseId], references: [id])
  lines         GoodsReceiptLine[]
  supplierInvoices SupplierInvoice[]

  @@index([companyId])
  @@index([companyId, purchaseOrderId])
}

model GoodsReceiptLine {
  id          String  @id @default(cuid())
  receiptId   String
  productId   String?
  description String
  orderedQty  Decimal @db.Decimal(10, 3)
  receivedQty Decimal @db.Decimal(10, 3)
  unitCost    Decimal @db.Decimal(15, 2)

  receipt GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

model SupplierInvoice {
  id              String                @id @default(cuid())
  companyId       String
  supplierId      String
  purchaseOrderId String?
  receiptId       String?
  number          String
  invoiceDate     DateTime
  dueDate         DateTime?
  subtotal        Decimal               @db.Decimal(15, 2)
  taxAmount       Decimal               @db.Decimal(15, 2)
  total           Decimal               @db.Decimal(15, 2)
  status          SupplierInvoiceStatus @default(PENDING)
  matchingStatus  String                @default("UNMATCHED")
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  company       Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier      Supplier              @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  receipt       GoodsReceipt?         @relation(fields: [receiptId], references: [id])
  lines         SupplierInvoiceLine[]

  @@index([companyId, status])
  @@index([companyId, supplierId])
}

enum SupplierInvoiceStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

model SupplierInvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(10, 3)
  unitPrice   Decimal @db.Decimal(15, 2)
  taxRate     Decimal @db.Decimal(5, 2) @default(19)
  total       Decimal @db.Decimal(15, 2)

  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model POApproval {
  id              String    @id @default(cuid())
  companyId       String
  purchaseOrderId String
  step            Int
  approverRole    Role
  approverId      String?
  status          String    @default("PENDING")
  comment         String?
  decidedAt       DateTime?

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([companyId, purchaseOrderId])
}

// ============================================================
// CRM — LEADS & PIPELINE
// ============================================================
model Lead {
  id             String     @id @default(cuid())
  companyId      String
  firstName      String?
  lastName       String
  company        String?
  email          String?
  phone          String?
  source         LeadSource @default(MANUAL)
  stage          LeadStage  @default(NEW)
  score          Int        @default(0)
  expectedValue  Decimal?   @db.Decimal(15, 2)
  expectedClose  DateTime?
  assignedTo     String?
  notes          String?    @db.Text
  lostReason     String?
  convertedAt    DateTime?
  clientId       String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  companyRel  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client      Client?        @relation(fields: [clientId], references: [id])
  activities  LeadActivity[]
  tasks       LeadTask[]

  @@index([companyId, stage])
  @@index([companyId, assignedTo])
}

enum LeadSource {
  MANUAL
  WEBSITE
  REFERRAL
  SHOPIFY
  WOOCOMMERCE
  PHONE
  EMAIL
  SOCIAL
  OTHER
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model LeadActivity {
  id       String       @id @default(cuid())
  leadId   String
  userId   String
  type     ActivityType
  subject  String
  notes    String?      @db.Text
  doneAt   DateTime     @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  TASK
}

model LeadTask {
  id         String    @id @default(cuid())
  leadId     String
  title      String
  dueDate    DateTime?
  isDone     Boolean   @default(false)
  assignedTo String?

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model Pipeline {
  id        String  @id @default(cuid())
  companyId String
  name      String
  stages    Json
  isDefault Boolean @default(false)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ============================================================
// PRODUCTION & FABRICATION (BOM)
// ============================================================
model BOM {
  id        String   @id @default(cuid())
  companyId String
  productId String
  name      String
  version   String   @default("1.0")
  isActive  Boolean  @default(true)
  yieldQty  Decimal  @db.Decimal(10, 3) @default(1)
  createdAt DateTime @default(now())

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id])
  components       BOMComponent[]
  productionOrders ProductionOrder[]

  @@index([companyId, productId])
}

model BOMComponent {
  id        String  @id @default(cuid())
  bomId     String
  productId String
  quantity  Decimal @db.Decimal(10, 3)
  unit      String?
  notes     String?

  bom     BOM     @relation(fields: [bomId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([bomId])
}

model ProductionOrder {
  id             String           @id @default(cuid())
  companyId      String
  bomId          String
  number         String
  status         ProductionStatus @default(DRAFT)
  plannedQty     Decimal          @db.Decimal(10, 3)
  producedQty    Decimal          @db.Decimal(10, 3) @default(0)
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  actualStart    DateTime?
  actualEnd      DateTime?
  notes          String?
  createdAt      DateTime         @default(now())

  company      Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bom          BOM                    @relation(fields: [bomId], references: [id])
  consumptions ProductionConsumption[]

  @@unique([companyId, number])
  @@index([companyId, status])
}

enum ProductionStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  DONE
  CANCELLED
}

model ProductionConsumption {
  id               String  @id @default(cuid())
  productionOrderId String
  productId        String
  plannedQty       Decimal @db.Decimal(10, 3)
  consumedQty      Decimal @db.Decimal(10, 3) @default(0)

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id])

  @@index([productionOrderId])
}

// ============================================================
// GESTION DE PROJET & FEUILLES DE TEMPS
// ============================================================
model Project {
  id          String         @id @default(cuid())
  companyId   String
  clientId    String?
  name        String
  code        String?
  status      ProjectStatus  @default(ACTIVE)
  description String?        @db.Text
  startDate   DateTime?
  endDate     DateTime?
  budget      Decimal?       @db.Decimal(15, 2)
  billingType ProjectBilling @default(FIXED)
  hourlyRate  Decimal?       @db.Decimal(10, 2)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company  Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client   Client?       @relation(fields: [clientId], references: [id])
  tasks    ProjectTask[]
  timeLogs TimeLog[]
  invoices Invoice[]

  @@index([companyId, status])
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectBilling {
  FIXED
  HOURLY
  MILESTONE
}

model ProjectTask {
  id             String     @id @default(cuid())
  projectId      String
  title          String
  description    String?    @db.Text
  status         TaskStatus @default(TODO)
  priority       String     @default("NORMAL")
  assignedTo     String?
  dueDate        DateTime?
  estimatedHours Decimal?   @db.Decimal(6, 2)
  completedAt    DateTime?

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  timeLogs TimeLog[]

  @@index([projectId, status])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

model TimeLog {
  id          String   @id @default(cuid())
  companyId   String
  projectId   String
  taskId      String?
  userId      String
  date        DateTime
  hours       Decimal  @db.Decimal(6, 2)
  description String
  isBillable  Boolean  @default(true)
  isInvoiced  Boolean  @default(false)

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId], references: [id])
  task    ProjectTask? @relation(fields: [taskId], references: [id])

  @@index([companyId, projectId])
  @@index([companyId, userId, date])
}

// ============================================================
// RH AVANCÉE — CONGÉS, RECRUTEMENT, ÉVALUATIONS
// ============================================================
model LeaveType {
  id             String @id @default(cuid())
  companyId      String
  name           String
  maxDaysPerYear Int    @default(30)
  isPaid         Boolean @default(true)

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requests LeaveRequest[]

  @@index([companyId])
}

model LeaveRequest {
  id             String      @id @default(cuid())
  companyId      String
  employeeId     String
  leaveTypeId    String
  startDate      DateTime
  endDate        DateTime
  days           Int
  reason         String?
  status         LeaveStatus @default(PENDING)
  approvedBy     String?
  approvedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime    @default(now())

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([companyId, status])
  @@index([employeeId])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model JobPosting {
  id           String        @id @default(cuid())
  companyId    String
  title        String
  department   String?
  description  String?       @db.Text
  requirements String?       @db.Text
  status       PostingStatus @default(OPEN)
  closingDate  DateTime?
  createdAt    DateTime      @default(now())

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([companyId, status])
}

enum PostingStatus {
  OPEN
  CLOSED
  ON_HOLD
}

model Application {
  id        String           @id @default(cuid())
  postingId String
  companyId String
  firstName String
  lastName  String
  email     String
  phone     String?
  cvUrl     String?
  stage     ApplicationStage @default(NEW)
  notes     String?          @db.Text
  createdAt DateTime         @default(now())

  posting JobPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)
  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([postingId, stage])
}

enum ApplicationStage {
  NEW
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

model PerformanceReview {
  id           String   @id @default(cuid())
  companyId    String
  employeeId   String
  reviewerId   String
  period       String
  score        Int?
  objectives   Json?
  strengths    String?  @db.Text
  improvements String?  @db.Text
  status       String   @default("DRAFT")
  createdAt    DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([companyId, employeeId])
}

// ============================================================
// MULTI-ENTREPÔTS
// ============================================================
model Warehouse {
  id        String  @id @default(cuid())
  companyId String
  name      String
  code      String
  address   String?
  wilaya    String?
  isDefault Boolean @default(false)

  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  locations      WarehouseLocation[]
  stockMovements StockMovement[]
  goodsReceipts  GoodsReceipt[]
  fromTransfers  StockTransfer[]     @relation("FromWarehouse")
  toTransfers    StockTransfer[]     @relation("ToWarehouse")

  @@unique([companyId, code])
  @@index([companyId])
}

model WarehouseLocation {
  id          String  @id @default(cuid())
  warehouseId String
  name        String
  barcode     String?

  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockPositions StockPosition[]

  @@index([warehouseId])
}

model StockPosition {
  id         String  @id @default(cuid())
  companyId  String
  productId  String
  locationId String
  quantity   Decimal @db.Decimal(10, 3) @default(0)

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id])
  location WarehouseLocation @relation(fields: [locationId], references: [id])

  @@unique([productId, locationId])
  @@index([companyId])
}

model StockTransfer {
  id              String         @id @default(cuid())
  companyId       String
  fromWarehouseId String
  toWarehouseId   String
  status          TransferStatus @default(DRAFT)
  scheduledDate   DateTime?
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime       @default(now())

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromWarehouse Warehouse           @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse           @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  lines         StockTransferLine[]

  @@index([companyId, status])
}

enum TransferStatus {
  DRAFT
  CONFIRMED
  IN_TRANSIT
  DONE
  CANCELLED
}

model StockTransferLine {
  id           String  @id @default(cuid())
  transferId   String
  productId    String
  requestedQty Decimal @db.Decimal(10, 3)
  doneQty      Decimal @db.Decimal(10, 3) @default(0)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])

  @@index([transferId])
}

// ============================================================
// MULTI-DEVISES
// ============================================================
model Currency {
  id     String  @id @default(cuid())
  code   String  @unique
  name   String
  symbol String
  isBase Boolean @default(false)
}

model ExchangeRate {
  id           String   @id @default(cuid())
  companyId    String
  fromCurrency String
  toCurrency   String
  rate         Decimal  @db.Decimal(12, 6)
  date         DateTime
  source       String   @default("MANUAL")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, fromCurrency, toCurrency, date])
  @@index([companyId, date])
}

// ============================================================
// CLÉS API (accès externe via Bearer token)
// ============================================================
model ApiKey {
  id         String    @id @default(cuid())
  companyId  String
  name       String
  keyHash    String    @unique
  keyPrefix  String
  lastUsedAt DateTime?
  isActive   Boolean   @default(true)
  scopes     String[]  @default(["read"])
  mode       String    @default("live")
  createdAt  DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([keyHash])
}

// ============================================================
// WEBHOOKS
// ============================================================
model Webhook {
  id          String   @id @default(cuid())
  companyId   String
  url         String
  events      String[]
  secret      String
  isActive    Boolean  @default(true)
  description String?
  lastTriggeredAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, isActive])
}

// ============================================================
// POINT DE VENTE (POS)
// ============================================================
model PosRegister {
  id        String   @id @default(cuid())
  companyId String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions PosSession[]

  @@index([companyId])
}

model PosSession {
  id            String           @id @default(cuid())
  companyId     String
  registerId    String?
  number        Int
  status        PosSessionStatus @default(OPEN)
  openingCash   Decimal          @db.Decimal(15, 2) @default(0)
  closingCash   Decimal?         @db.Decimal(15, 2)
  totalSales    Decimal          @db.Decimal(15, 2) @default(0)
  totalCash     Decimal          @db.Decimal(15, 2) @default(0)
  totalCard     Decimal          @db.Decimal(15, 2) @default(0)
  totalDebt     Decimal          @db.Decimal(15, 2) @default(0)
  resetInterval String           @default("daily")
  notes         String?
  openedAt      DateTime         @default(now())
  closedAt      DateTime?

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  register PosRegister? @relation(fields: [registerId], references: [id])
  sales    PosSale[]

  @@index([companyId, status])
  @@index([companyId, openedAt])
}

enum PosSessionStatus {
  OPEN
  CLOSED
}

model PosSale {
  id            String           @id @default(cuid())
  companyId     String
  sessionId     String
  invoiceId     String?          @unique
  clientId      String?
  paymentMethod PosPaymentMethod @default(CASH)
  subtotal      Decimal          @db.Decimal(15, 2)
  taxAmount     Decimal          @db.Decimal(15, 2)
  total         Decimal          @db.Decimal(15, 2)
  amountPaid    Decimal          @db.Decimal(15, 2)
  change        Decimal          @db.Decimal(15, 2) @default(0)
  createdAt     DateTime         @default(now())

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  session PosSession  @relation(fields: [sessionId], references: [id])
  invoice Invoice?    @relation(fields: [invoiceId], references: [id])
  client  Client?     @relation(fields: [clientId], references: [id])
  debt    PosDebt?

  @@index([companyId, sessionId])
  @@index([companyId, createdAt])
}

enum PosPaymentMethod {
  CASH
  CARD
  DEBT
}

model PosDebt {
  id          String        @id @default(cuid())
  companyId   String
  clientId    String
  saleId      String?       @unique
  invoiceId   String?       @unique
  totalAmount Decimal       @db.Decimal(15, 2)
  paidAmount  Decimal       @db.Decimal(15, 2) @default(0)
  dueDate     DateTime?
  notes       String?
  status      PosDebtStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client   Client           @relation(fields: [clientId], references: [id])
  sale     PosSale?         @relation(fields: [saleId], references: [id])
  invoice  Invoice?         @relation(fields: [invoiceId], references: [id])
  payments PosDebtPayment[]

  @@index([companyId, clientId])
  @@index([companyId, status])
}

enum PosDebtStatus {
  PENDING
  PARTIAL
  PAID
}

model PosDebtPayment {
  id     String           @id @default(cuid())
  debtId String
  amount Decimal          @db.Decimal(15, 2)
  method PosPaymentMethod @default(CASH)
  note   String?
  paidAt DateTime         @default(now())

  debt PosDebt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId])
}

// ============================================================
// E-COMMERCE — LIVRAISON
// ============================================================

model DeliveryCompany {
  id            String              @id @default(cuid())
  companyId     String
  name          String
  slug          DeliverySlug        @default(OTHER)
  isDefault     Boolean             @default(false)
  isActive      Boolean             @default(true)
  apiKey        String?
  apiSecret     String?
  webhookSecret String?
  config        Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deliveryOptions DeliveryOption[]
  orders          EcomOrder[]
  drivers         DeliveryDriver[]

  @@index([companyId])
  @@index([companyId, isDefault])
}

enum DeliverySlug {
  MANUAL
  YALIDINE
  MAYSTRO
  PROCOLIS
  ECOTRACK
  GUEPEX
  ZR_EXPRESS
  OTHER
}

model DeliveryOption {
  id                String          @id @default(cuid())
  deliveryCompanyId String
  name              String
  price             Decimal         @db.Decimal(10, 2) @default(0)
  description       String?
  isActive          Boolean         @default(true)

  deliveryCompany DeliveryCompany @relation(fields: [deliveryCompanyId], references: [id], onDelete: Cascade)
  orders          EcomOrder[]

  @@index([deliveryCompanyId])
}

model DeliveryDriver {
  id                String          @id @default(cuid())
  companyId         String
  deliveryCompanyId String?
  name              String
  phone             String
  email             String?
  wilaya            String?
  vehicleType       String?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deliveryCompany DeliveryCompany? @relation(fields: [deliveryCompanyId], references: [id])
  orders          EcomOrder[]

  @@index([companyId])
}

model EcomOrder {
  id                 String           @id @default(cuid())
  companyId          String
  orderNumber        String
  customerName       String
  customerFirstName  String?
  customerPhone      String
  customerPhone2     String?
  customerAddress    String
  customerWilaya     String
  customerCommune    String?
  productDescription String
  productPrice       Decimal          @db.Decimal(15, 2)
  quantity           Int              @default(1)
  deliveryCompanyId  String?
  deliveryOptionId   String?
  deliveryDriverId   String?
  deliveryFee        Decimal          @db.Decimal(10, 2) @default(0)
  total              Decimal          @db.Decimal(15, 2)
  status             EcomOrderStatus  @default(PENDING)
  externalId         String?
  externalStatus     String?
  trackingNumber     String?
  isPaid             Boolean          @default(false)
  notes              String?
  confirmedAt        DateTime?
  shippedAt          DateTime?
  deliveredAt        DateTime?
  returnedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deliveryCompany DeliveryCompany? @relation(fields: [deliveryCompanyId], references: [id])
  deliveryOption  DeliveryOption?  @relation(fields: [deliveryOptionId], references: [id])
  driver          DeliveryDriver?  @relation(fields: [deliveryDriverId], references: [id])
  statusHistory   EcomStatusHistory[]

  @@unique([companyId, orderNumber])
  @@index([companyId, status])
  @@index([companyId, createdAt])
}

enum EcomOrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  NO_ANSWER
  RETURNED
  CANCELLED
}

model EcomStatusHistory {
  id        String          @id @default(cuid())
  orderId   String
  status    EcomOrderStatus
  note      String?
  source    String          @default("MANUAL")
  createdAt DateTime        @default(now())

  order EcomOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ============================================================
// ABONNEMENTS
// ============================================================
model SubscriptionPlan {
  id            String      @id @default(cuid())
  companyId     String
  name          String
  description   String?     @db.Text
  price         Decimal     @db.Decimal(10, 2)
  currency      String      @default("DZD")
  interval      SubInterval @default(MONTHLY)
  intervalCount Int         @default(1)
  trialDays     Int?
  features      String[]    @default([])
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([companyId])
}

model Subscription {
  id             String     @id @default(cuid())
  companyId      String
  clientId       String
  planId         String
  status         SubStatus  @default(ACTIVE)
  startDate      DateTime   @default(now())
  endDate        DateTime?
  nextBilling    DateTime?
  cancelledAt    DateTime?
  notes          String?    @db.Text
  // Email du client (pour rappels)
  clientEmail    String?
  // Anti-spam : derniers emails envoyés (date)
  lastRenewalReminder3At DateTime?
  lastRenewalReminderAt  DateTime?
  lastTrialEndReminderAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client           @relation(fields: [clientId], references: [id])
  plan    SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([companyId])
  @@index([companyId, status])
  @@index([clientId])
}

model SubscriptionSettings {
  id             String   @id @default(cuid())
  companyId      String   @unique
  // Paiement (affichés dans les emails de rappel)
  whatsapp       String?
  ccpNumber      String?
  chargilyKey    String?
  // Email
  emailLanguage  String   @default("fr") // fr | en | ar
  emailTemplates Json     @default("{}") // { renewal: { fr: {subject, body}, ... }, trialEnd: { ... } }
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

enum SubInterval {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum SubStatus {
  PENDING
  TRIAL
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

// ============================================================
// RESTAURANT
// ============================================================

model RestaurantConfig {
  id                 String   @id @default(cuid())
  companyId          String   @unique
  name               String
  address            String?
  phone              String?
  logo               String?
  currency           String   @default("DZD")
  taxRate            Decimal  @db.Decimal(5, 2) @default(19)
  serviceCharge      Decimal  @db.Decimal(5, 2) @default(0)
  receiptFooter      String?
  tablePrefix        String   @default("T")
  orderPrefix        String   @default("CMD")
  enableQrMenu       Boolean  @default(true)
  enableLoyalty      Boolean  @default(false)
  loyaltyPointsRate  Decimal  @db.Decimal(5, 2) @default(1)
  enableDelivery     Boolean  @default(false)
  deliveryFeeDefault Decimal  @db.Decimal(10, 2) @default(0)
  activeStations     String[] @default(["MAIN"])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model RestaurantRoom {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tables  RestaurantTable[]

  @@index([companyId])
}

model RestaurantTable {
  id        String      @id @default(cuid())
  companyId String
  roomId    String
  number    String
  capacity  Int         @default(4)
  shape     TableShape  @default(SQUARE)
  posX      Int         @default(0)
  posY      Int         @default(0)
  width     Int         @default(80)
  height    Int         @default(80)
  status    TableStatus @default(AVAILABLE)
  qrToken   String?     @unique
  isActive  Boolean     @default(true)

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  room         RestaurantRoom    @relation(fields: [roomId], references: [id])
  orders       RestaurantOrder[]
  reservations Reservation[]

  @@index([companyId, status])
  @@index([companyId, roomId])
}

enum TableShape {
  SQUARE
  ROUND
  RECTANGLE
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
}

model Reservation {
  id           String            @id @default(cuid())
  companyId    String
  tableId      String?
  guestName    String
  guestPhone   String
  guestCount   Int               @default(2)
  date         DateTime
  duration     Int               @default(90)
  status       ReservationStatus @default(CONFIRMED)
  notes        String?
  reminderSent Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  table   RestaurantTable? @relation(fields: [tableId], references: [id])

  @@index([companyId, date])
  @@index([companyId, status])
}

enum ReservationStatus {
  CONFIRMED
  ARRIVED
  CANCELLED
  NO_SHOW
}

model MenuCategory {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  nameAr      String?
  description String?
  imageUrl    String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
  isAvailable Boolean @default(true)

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   MenuItem[]

  @@index([companyId, isActive])
}

model MenuItem {
  id              String   @id @default(cuid())
  companyId       String
  categoryId      String
  name            String
  nameAr          String?
  description     String?  @db.Text
  imageUrl        String?
  price           Decimal  @db.Decimal(10, 2)
  taxRate         Decimal  @db.Decimal(5, 2) @default(19)
  preparationTime Int      @default(10)
  isAvailable     Boolean  @default(true)
  isActive        Boolean  @default(true)
  allergens       String[] @default([])
  tags            String[] @default([])
  sortOrder       Int      @default(0)
  loyaltyPoints   Int      @default(0)

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category    MenuCategory         @relation(fields: [categoryId], references: [id])
  orderLines  RestaurantOrderLine[]
  ingredients MenuIngredient[]

  @@index([companyId, categoryId])
  @@index([companyId, isAvailable])
}

model MenuIngredient {
  id           String  @id @default(cuid())
  menuItemId   String
  ingredientId String
  quantity     Decimal @db.Decimal(10, 4)
  unit         String  @default("g")

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([menuItemId, ingredientId])
}

model Ingredient {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  unit         String   @default("g")
  currentStock Decimal  @db.Decimal(10, 3) @default(0)
  minStock     Decimal  @db.Decimal(10, 3) @default(0)
  unitCost     Decimal  @db.Decimal(10, 2) @default(0)
  erpProductId String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  menuIngredients MenuIngredient[]
  stockMovements  IngredientMovement[]

  @@index([companyId])
}

model IngredientMovement {
  id           String             @id @default(cuid())
  companyId    String
  ingredientId String
  type         IngredientMoveType
  quantity     Decimal            @db.Decimal(10, 3)
  unitCost     Decimal?           @db.Decimal(10, 2)
  reference    String?
  note         String?
  createdAt    DateTime           @default(now())

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([companyId, ingredientId])
  @@index([companyId, createdAt])
}

enum IngredientMoveType {
  IN
  OUT
  WASTE
  ADJUSTMENT
}

model RestaurantOrder {
  id              String              @id @default(cuid())
  companyId       String
  number          String
  type            OrderType           @default(DINE_IN)
  status          OrderStatus         @default(PENDING)
  tableId         String?
  guestCount      Int?
  customerName    String?
  customerPhone   String?
  customerAddress String?
  deliveryNote    String?
  deliveryFee     Decimal             @db.Decimal(10, 2) @default(0)
  loyaltyClientId String?
  subtotal        Decimal             @db.Decimal(10, 2) @default(0)
  taxAmount       Decimal             @db.Decimal(10, 2) @default(0)
  serviceCharge   Decimal             @db.Decimal(10, 2) @default(0)
  discount        Decimal             @db.Decimal(10, 2) @default(0)
  discountReason  String?
  total           Decimal             @db.Decimal(10, 2) @default(0)
  paymentMethod   RestaurantPayMethod?
  paymentStatus   RestaurantPayStatus @default(UNPAID)
  chargilyLink    String?
  paidAt          DateTime?
  notes           String?
  estimatedReady  DateTime?
  acceptedAt      DateTime?
  readyAt         DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  company       Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  table         RestaurantTable?      @relation(fields: [tableId], references: [id])
  loyaltyClient LoyaltyClient?        @relation(fields: [loyaltyClientId], references: [id])
  lines         RestaurantOrderLine[]
  kdsTickets    KdsTicket[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, type])
  @@index([companyId, tableId])
  @@index([companyId, createdAt])
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  DELIVERED
  CANCELLED
  CLOSED
}

enum RestaurantPayMethod {
  CASH
  CHARGILY_EDAHABIA
  CHARGILY_CIB
  CCP_VIREMENT
}

enum RestaurantPayStatus {
  UNPAID
  PARTIAL
  PAID
}

model RestaurantOrderLine {
  id         String     @id @default(cuid())
  orderId    String
  menuItemId String
  name       String
  price      Decimal    @db.Decimal(10, 2)
  taxRate    Decimal    @db.Decimal(5, 2)
  quantity   Int        @default(1)
  total      Decimal    @db.Decimal(10, 2)
  notes      String?
  status     LineStatus @default(PENDING)
  sentToKds  Boolean    @default(false)

  order    RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem        @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
}

enum LineStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

model KdsTicket {
  id         String     @id @default(cuid())
  companyId  String
  orderId    String
  station    KdsStation @default(MAIN)
  status     KdsStatus  @default(NEW)
  priority   Int        @default(0)
  printedAt  DateTime?
  acceptedAt DateTime?
  doneAt     DateTime?
  createdAt  DateTime   @default(now())

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order   RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([companyId, station])
}

enum KdsStation {
  MAIN
  GRILL
  COLD
  DRINKS
  DESSERT
}

enum KdsStatus {
  NEW
  ACCEPTED
  DONE
}

model LoyaltyClient {
  id          String      @id @default(cuid())
  companyId   String
  name        String
  phone       String
  email       String?
  points      Int         @default(0)
  totalSpent  Decimal     @db.Decimal(15, 2) @default(0)
  visitsCount Int         @default(0)
  tier        LoyaltyTier @default(STANDARD)
  qrCode      String      @unique
  isActive    Boolean     @default(true)
  joinedAt    DateTime    @default(now())
  lastVisit   DateTime?

  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders       RestaurantOrder[]
  transactions LoyaltyTransaction[]

  @@unique([companyId, phone])
  @@index([companyId])
}

enum LoyaltyTier {
  STANDARD
  SILVER
  GOLD
  VIP
}

model LoyaltyTransaction {
  id          String        @id @default(cuid())
  clientId    String
  type        LoyaltyTxType
  points      Int
  description String
  orderId     String?
  createdAt   DateTime      @default(now())

  client LoyaltyClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

enum LoyaltyTxType {
  EARNED
  REDEEMED
  BONUS
  EXPIRED
}

model RestaurantOrderSequence {
  id        String @id @default(cuid())
  companyId String @unique
  seq       Int    @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model InvoiceSequence {
  id        String @id @default(cuid())
  companyId String
  prefix    String
  seq       Int    @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, prefix])
}

// ============================================================
// YELHA SUBSCRIPTION (abonnement YelhaERP)
// ============================================================
model YelhaSubscription {
  id                 String         @id @default(cuid())
  companyId          String         @unique
  planId             String         @default("trial")
  status             YelhaSubStatus @default(TRIAL)
  billingCycle       BillingCycle   @default(MONTHLY)

  extraApps          String[]       @default([])
  trialApps          String[]       @default([])
  appTrialsEndsAt    Json           @default("{}")

  trialEndsAt        DateTime?
  currentPeriodStart DateTime       @default(now())
  currentPeriodEnd   DateTime
  cancelledAt        DateTime?
  pausedAt           DateTime?

  monthlyAmount      Int            @default(0)
  lastPaymentAt      DateTime?
  lastPaymentRef     String?
  chargilySubId      String?

  limitEmails        Int            @default(50)
  limitApiReq        Int            @default(500)
  limitDeliverers    Int            @default(0)
  limitSkus          Int            @default(50)
  limitAiReq         Int            @default(15)

  usageEmails        Int            @default(0)
  usageApiReq        Int            @default(0)
  usageAiReq         Int            @default(0)
  usageResetAt       DateTime       @default(now())

  lastRenewalReminder3At DateTime?
  lastRenewalReminder1At DateTime?

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  company            Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payments           YelhaPayment[]
}

model YelhaPayment {
  id             String            @id @default(cuid())
  subscriptionId String
  amount         Int
  planId         String
  extraApps      String[]
  billingCycle   BillingCycle
  method         String
  status         String            @default("PENDING")
  chargilyId     String?
  chargilyLink   String?
  ccpRef         String?
  periodStart    DateTime
  periodEnd      DateTime
  paidAt         DateTime?
  createdAt      DateTime          @default(now())

  subscription   YelhaSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

// ============================================================
// ABONNEMENTS PAR APP (tarification indépendante)
// ============================================================
model AppSubscription {
  id                 String       @id @default(cuid())
  companyId          String
  appId              String       // ex: "subscriptions"
  planId             String       @default("trial") // trial | starter | premium | pro | agency
  status             String       @default("TRIAL") // TRIAL | ACTIVE | CANCELLED | EXPIRED
  trialEndsAt        DateTime?
  currentPeriodStart DateTime     @default(now())
  currentPeriodEnd   DateTime
  monthlyAmount      Int          @default(0)
  lastPaymentAt      DateTime?
  lastPaymentRef     String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payments AppPayment[]

  @@unique([companyId, appId])
  @@index([companyId])
}

model AppPayment {
  id                String          @id @default(cuid())
  appSubscriptionId String
  appId             String
  planId            String
  amount            Int
  method            String          // CCP | ADMIN_FREE | ADMIN_ACTIVATE
  status            String          @default("PENDING") // PENDING | PAID
  ccpRef            String?
  chargilyId        String?
  chargilyLink      String?
  periodStart       DateTime
  periodEnd         DateTime
  paidAt            DateTime?
  createdAt         DateTime        @default(now())

  appSubscription AppSubscription @relation(fields: [appSubscriptionId], references: [id], onDelete: Cascade)

  @@index([appSubscriptionId])
}

// ============================================================
// CONFIG SYSTÈME (tarification admin)
// ============================================================
model SystemConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
